{
  "name": "avatarscript",
  "version": "0.1.0",
  "description": "Turn an avatar and text into a lip-synced, acted video.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "avatarscript": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "avatarscript": "node src/cli.ts",
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kuromoji": "^0.1.2",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/avatarscript.git"
  },
  "keywords": [
    "avatar",
    "lip-sync",
    "tts",
    "elevenlabs",
    "video"
  ]
}
