{
  "name": "avatarscript",
  "version": "0.4.0",
  "description": "Turn an avatar and text into a lip-synced, acted video.",
  "keywords": [
    "avatar",
    "lip-sync",
    "tts",
    "elevenlabs",
    "video"
  ],
  "homepage": "https://github.com/receptron/avatarscript#readme",
  "bugs": {
    "url": "https://github.com/receptron/avatarscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/avatarscript.git"
  },
  "license": "MIT",
  "author": "receptron",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "avatarscript": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "avatarscript": "node src/cli.ts",
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "kuromoji": "^0.1.2",
    "puppeteer": "^25.12.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "onnxruntime-node": "^1.30.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "onnxruntime-node": "^1.30.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
